{
  "name": "rhia-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RHIA 2.0 – lokale, kontrollierbare Assistenzbasis",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @rhia/web dev",
    "build": "pnpm --filter @rhia/web build",
    "preview": "pnpm --filter @rhia/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "audit:public": "node scripts/public-build-audit.mjs",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit:public && pnpm scan:secrets && pnpm audit:deps"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
